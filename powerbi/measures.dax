-- Urban Mobility & Fleet Intelligence
-- Suggested Power BI measures

Total Trips =
SUM(VW_POWERBI_OPERATIONS[TOTAL_TRIPS])

Member Trips =
SUM(VW_POWERBI_OPERATIONS[MEMBER_TRIPS])

Casual Trips =
SUM(VW_POWERBI_OPERATIONS[CASUAL_TRIPS])

Member Trip Share =
DIVIDE([Member Trips], [Total Trips])

Casual Trip Share =
DIVIDE([Casual Trips], [Total Trips])

Average Trip Duration =
AVERAGE(VW_POWERBI_OPERATIONS[AVG_TRIP_DURATION_MINUTES])

Active Stations =
MAX(VW_POWERBI_OPERATIONS[TOTAL_ACTIVE_STATIONS])

Available Vehicles =
MAX(VW_POWERBI_OPERATIONS[TOTAL_AVAILABLE_VEHICLES])

Station Trips =
SUM(VW_POWERBI_STATION[TOTAL_STATION_TRIPS])

Origin Trips =
SUM(VW_POWERBI_STATION[TRIP_ORIGIN_COUNT])

Destination Trips =
SUM(VW_POWERBI_STATION[TRIP_DESTINATION_COUNT])

Average Vehicles Available =
AVERAGE(VW_POWERBI_STATION[AVG_VEHICLES_AVAILABLE])

Average Docks Available =
AVERAGE(VW_POWERBI_STATION[AVG_DOCKS_AVAILABLE])

Rider Trips =
SUM(VW_POWERBI_RIDER[TOTAL_TRIPS])

Unique Start Stations =
SUM(VW_POWERBI_RIDER[UNIQUE_START_STATIONS])

Unique End Stations =
SUM(VW_POWERBI_RIDER[UNIQUE_END_STATIONS])

Fleet Vehicle Count =
SUM(VW_POWERBI_FLEET[VEHICLE_COUNT])

Active Vehicle Count =
SUM(VW_POWERBI_FLEET[ACTIVE_VEHICLE_COUNT])

Active Fleet Share =
DIVIDE([Active Vehicle Count], [Fleet Vehicle Count])

Latest Fleet Snapshot =
MAX(VW_POWERBI_FLEET[LAST_SNAPSHOT_TIMESTAMP])
